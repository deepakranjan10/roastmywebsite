# Postgres connection string. If unset, the app falls back to an in-memory
# store so it still runs locally without infrastructure (dev/demo only —
# audits and the leaderboard will not persist across restarts).
DATABASE_URL="postgresql://user:password@localhost:5432/roastmywebsite"

# Optional. When set, the roast engine asks OpenAI to punch up the
# rule-based roast lines. The app is fully functional without this key —
# the deterministic template engine is the default and does all scoring
# and finding generation regardless.
OPENAI_API_KEY=""

# Optional. Enables real Core Web Vitals / Lighthouse data via Google
# PageSpeed Insights. Without it, performance findings are derived from
# raw response signals (page weight, request count, render-blocking tags)
# and Core Web Vitals are reported as "Not available".
PAGESPEED_API_KEY=""

# Optional. Base URL of a screenshot service that accepts
# `${SCREENSHOT_SERVICE_URL}<encoded-url>` and returns an image (e.g. a
# thum.io or screenshotone endpoint). Without it, result pages show a
# stylized placeholder instead of a live screenshot.
SCREENSHOT_SERVICE_URL=""

# Public base URL of this deployment, used to build absolute share links
# and Open Graph image URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
